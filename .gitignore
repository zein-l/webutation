# --- secrets -------------------------------------------------------------
.env
*.pem
*.key

# --- collected data ------------------------------------------------------
# Search responses, fetched images, uploaded subject photos and the HMAC
# signing key all live here. It holds photographs of real people and the
# personal data a run collected about them, so it never leaves this machine.
cache/
uploads/

# Loose images at the repo root: subject photographs handed to the pipeline,
# and screenshots.
/*.png
/*.jpg
/*.jpeg
/*.webp

# Screenshots anywhere, not just at the root. One of these was found holding a
# live SerpAPI key in a visible command line, so they are excluded by name
# wherever they land rather than only where they happened to be that day.
# Deliberately not a blanket **/*.png: the frontend may legitimately need an
# icon, and an ignore rule that blocks real assets gets deleted wholesale.
Screenshot*
screenshot*
Screen Shot*
*.screenshot.*

# --- model weights -------------------------------------------------------
# buffalo_l is ~300MB and is baked into the Docker image at build time.
*.onnx
insightface-models/
.insightface/
models/buffalo_l/

# --- environments and builds ---------------------------------------------
venv/
.venv/
node_modules/
frontend/dist/
frontend/.vite/
dist/
build/

# --- python --------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# --- working notes -------------------------------------------------------
# The challenge brief and build plan. Working material, not part of the
# deliverable, and it names people at the company the work was done for.
webutation-challenge-plan*.md

# --- editors and os ------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
