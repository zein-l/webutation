SERPAPI_KEY=
DATABASE_URL=postgresql://postgres:dev@localhost:5432/webutation
# Where face model weights are cached. Defaults to ~/.insightface, which is
# the system drive and is not always where the space is. The Docker image
# sets this to /opt/insightface, where the weights are baked at build time.
INSIGHTFACE_HOME=

# Origin this service is published under, as reachable from the public
# internet. SerpAPI's Lens and Yandex engines fetch the subject photo from
# their own servers, so localhost will not do. Leave unset and reverse image
# search reports failed with a reason rather than pretending it found nothing.
PUBLIC_BASE_URL=
# HMAC key for signed upload URLs. Generated and stored under cache/uploads/
# when unset, so restarting does not invalidate URLs already handed out.
UPLOAD_SIGNING_KEY=
# How long an uploaded subject photo survives on disk, in seconds. Default
# 86400 (24 hours). A missing or nonsense value falls back to 24 hours rather
# than to keeping the photograph forever. See README, "Photo retention".
UPLOAD_RETENTION_SECONDS=
# How often the retention sweep runs. Never longer than the window above.
UPLOAD_SWEEP_INTERVAL_SECONDS=
